# Copy values into your shell environment before starting the API.
API_HOST=127.0.0.1
API_PORT=8080
ATTENDANCE_DB=backend/attendance.db
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set SMTP values for real email OTP. Without SMTP_HOST, OTP is printed in API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Restrict to a real web origin when publishing a browser client.
CORS_ORIGIN=*
